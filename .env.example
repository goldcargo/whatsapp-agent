# Copie estas variables en Vercel → Project → Settings → Environment Variables.
# Nunca suba valores reales al repositorio.

# --- DeepSeek ---
DEEPSEEK_API_KEY=
# Verifique el nombre vigente en https://api-docs.deepseek.com (deepseek-chat / deepseek-reasoner fueron retirados).
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Zernio ---
ZERNIO_API_KEY=
# Secreto que usted define al registrar el webhook en Zernio (POST /v1/webhooks/settings o el dashboard).
ZERNIO_WEBHOOK_SECRET=
# accountId de la cuenta de WhatsApp en Zernio (solo lo usa /api/remarketing si no se envía en el cuerpo).
ZERNIO_ACCOUNT_ID=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# --- Almacenamiento (Upstash Redis / Vercel KV, API REST) ---
# Sirve cualquiera de los dos pares de nombres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Notificación al asesor ---
# URL que recibe cada bloque #TRASPASO_ASESOR como POST JSON (incluye campo "text",
# compatible con webhooks entrantes de Slack o Google Chat, y con Make/Zapier/n8n).
ADVISOR_WEBHOOK_URL=
# Opcional: URL distinta solo para PRIORIDAD: URGENTE. Si está vacía se usa ADVISOR_WEBHOOK_URL.
URGENT_WEBHOOK_URL=

# --- Comportamiento ---
# Horas que GOLD AI queda en pausa en una conversación después de que un asesor escribe desde Zernio.
BOT_PAUSE_HOURS=24
# Clave para proteger /api/remarketing (Authorization: Bearer <clave>).
ADMIN_API_KEY=
